# Minimal defconfig for NanoPi Zero2 ImageBuilder build.
# Target + profile selection only — `make defconfig` fills in the rest.
# The ImageBuilder tarball includes all available packages from feeds,
# so individual package selection here is for the base image only.
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-zero2=y
