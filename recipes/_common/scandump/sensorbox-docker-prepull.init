#!/bin/sh /etc/rc.common
START=99
STOP=

MAX_ATTEMPTS=6
IMAGE=ghcr.io/dboze/scandump:latest

boot() {
    # Wait for dockerd to accept connections (up to 60s).
    for i in $(seq 1 60); do
        docker info >/dev/null 2>&1 && break
        sleep 1
    done

    if ! docker info >/dev/null 2>&1; then
        logger -t sensorbox-docker-prepull "dockerd not ready after 60s; giving up"
        /etc/init.d/sensorbox-docker-prepull disable 2>/dev/null
        rm -f /etc/init.d/sensorbox-docker-prepull
        return 1
    fi

    attempt=0
    while [ "$attempt" -lt "$MAX_ATTEMPTS" ]; do
        attempt=$((attempt + 1))
        if docker pull "$IMAGE" >/dev/null 2>&1; then
            logger -t sensorbox-docker-prepull "pulled $IMAGE (attempt $attempt/$MAX_ATTEMPTS)"
            /etc/init.d/sensorbox-docker-prepull disable 2>/dev/null
            rm -f /etc/init.d/sensorbox-docker-prepull
            return 0
        fi
        logger -t sensorbox-docker-prepull "attempt $attempt/$MAX_ATTEMPTS failed"

        # Backoff: 30s, 60s, 120s, 240s, 480s between retries.
        if [ "$attempt" -lt "$MAX_ATTEMPTS" ]; then
            sleep $((30 * (1 << (attempt - 1))))
        fi
    done

    logger -t sensorbox-docker-prepull "exhausted $MAX_ATTEMPTS attempts; first scandump call will pull on demand"
    /etc/init.d/sensorbox-docker-prepull disable 2>/dev/null
    rm -f /etc/init.d/sensorbox-docker-prepull
}
